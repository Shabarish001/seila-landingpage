# Use the existing Supabase project's pooled PostgreSQL connection string.
# Never prefix server-only secrets with NEXT_PUBLIC_.
DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:6543/postgres
WAITLIST_RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters
SUPABASE_DB_CA_FILE=certs/supabase-ca.crt

# On Vercel, set SUPABASE_DB_CA_CERT to the certificate PEM instead of using a file path.

# Publishable details shown in the privacy notice.
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=privacy@example.com
